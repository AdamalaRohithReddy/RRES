# ==========================================
# AI Service Configuration - Environment Variables
# ==========================================

# Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384

# Qdrant Vector Store Configuration
# If QDRANT_URL is not set or empty, Qdrant will run in embedded mode using QDRANT_PATH.
# Use ':memory:' for transient in-memory storage (e.g. testing), or a local folder path.
QDRANT_PATH=./data/processed/qdrant_storage
QDRANT_COLLECTION_NAME=scheme_documents
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Retrieval Settings
DEFAULT_TOP_K=5
SCORE_THRESHOLD=0.35

# Ingestion Settings
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
OCR_CHAR_THRESHOLD_PER_PAGE=50

# OpenAI LLM Configuration (Milestone 2)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ==========================================
# MySQL Database Configuration (Milestone 7)
# ==========================================
# MySQL service credentials (PyMySQL driver)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=citizen_ai_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_RECYCLE=3600
MYSQL_POOL_TIMEOUT=30

# Fallback Policy:
# Strictly False by default. When False, a MySQL failure returns a structured
# "service temporarily unavailable" error notice instead of silently returning mock data.
ALLOW_MOCK_FALLBACK=False

# Database URL Override (Optional - e.g. for sqlite:///:memory: in tests or cloud instances)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/citizen_ai_db?charset=utf8mb4

# ==========================================
# Government API Integration (Milestone 8)
# ==========================================
GOV_API_ENABLED=false
GOV_API_ENVIRONMENT=sandbox
GOV_API_TIMEOUT_SECONDS=10
GOV_API_MAX_RETRIES=2
GOV_API_CACHE_TTL_SECONDS=300
GOV_API_RATE_LIMIT_PER_SEC=5

# API Setu Credentials (partners.apisetu.gov.in)
APISETU_BASE_URL=https://apisetu.gov.in/api/v1
APISETU_CLIENT_ID=
APISETU_API_KEY=

# Open Government Data (data.gov.in)
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/
DATA_GOV_IN_API_KEY=

# Optional Live Testing Flag (Default: false)
RUN_LIVE_GOV_API_TESTS=false
